DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
# "true" to connect over TLS. Anything else (or unset) disables SSL.
DB_SSL=
# Only used when DB_SSL=true. Set "false" to skip cert validation (e.g. self-signed dev DB).
DB_SSL_REJECT_UNAUTHORIZED=

RMQ_HOST=
RMQ_PORT=

AUTH_SERVICE_HOST=
AUTH_SERVICE_PORT=
GUILDS_SERVICE_HOST=
GUILDS_SERVICE_PORT=

APP_PORT=
GRPC_PORT=

# Static keys are optional — leave blank in prod to use EKS Pod Identity / IRSA.
# Set them for local dev or non-AWS S3-compatible storage (MinIO, etc.).
S3_ACCESS_KEY_ID=
S3_ACCESS_KEY_SECRET=
S3_REGION=
# Optional — set only for non-AWS S3-compatible storage.
S3_ENDPOINT=
CDN_ENDPOINT=

BUCKET_NAME=viscord

OTEL_EXPORTER_OTLP_ENDPOINT=